# Copy to .env and fill in. .env is in .gitignore and never gets committed.
# Everything the application needs to know about the world it is running in
# is in this file. Nothing here appears in the code.

# --- the model provider (GenAI Lesson 7) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE=https://api.openai.com/v1
GEN_MODEL=gpt-4o-mini

# --- the databases ---
# Postgres's credentials, written once. compose.yml gives them to the postgres
# container and builds the API's in-network DATABASE_URL from them (Lesson 6).
POSTGRES_USER=docchat
POSTGRES_PASSWORD=docchat
POSTGRES_DB=docchat

# Host ports for compose.yml. If a default is taken on your machine, change it
# here and the URLs below follow.
POSTGRES_PORT=5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Where the app finds the databases when it runs on the host: localhost and the
# host ports. Inside compose they are service names, postgres:5432 and qdrant:6333,
# and compose.yml sets that. It is the whole of what Lesson 6 changes.
QDRANT_URL=http://localhost:${QDRANT_PORT}
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- local models, run in-process on CPU ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- retrieval, the Lesson 15 and 16 settings ---
SHORTLIST=20
TOP_K=5
GATE=0.15
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
# The cross-encoder that reorders the shortlist, and the refusal gate on its score.
# Lesson 8 turns it off on purpose, to find the damage through the golden set and a trace.
RERANK=true

# --- the API (Lesson 3) and the UI (Lesson 5) ---
# The server binds API_HOST:API_PORT. Clients, the notebooks and Lesson 5's UI,
# call API_URL. Inside compose the API binds 0.0.0.0:8000, API_PORT becomes its
# host port, and the UI calls http://api:8000. UI_PORT is the page's host port.
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://localhost:${API_PORT}
UI_PORT=8501
MAX_UPLOAD_MB=50

# --- the conversation and its limits (Lesson 4) ---
# HISTORY_TOKENS caps the past turns sent back to the model; older turns are
# folded into a summary of at most SUMMARY_TOKENS. USER_DAILY_TOKENS is what
# one X-User-Id may spend in a rolling 24 hours.
HISTORY_TOKENS=1200
SUMMARY_TOKENS=200
USER_DAILY_TOKENS=50000
CACHE_ANSWERS=true
GUARD_CONTEXT=true

# --- a model you run yourself (Lesson 7) ---
# The ollama service in compose.yml pulls OLLAMA_MODEL on its first start: Qwen3 4B,
# instruction-tuned, at 4 bits, about 2.5 GB. OLLAMA_PORT is its host port, for the
# notebook; change it if 11434 is taken, for example by an Ollama installed natively.
# OLLAMA_CONTEXT_LENGTH is the longest prompt it reads; longer ones are cut, silently.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_PORT=11434
OLLAMA_CONTEXT_LENGTH=4096
# With an NVIDIA GPU and its container toolkit, uncomment this and Ollama runs on the GPU.
# COMPOSE_FILE=compose.yml:compose.gpu.yml

# --- the fallback provider (Lesson 4) ---
# Tried when the primary fails or times out. Since Lesson 7 it is the model above,
# reached through Ollama's OpenAI-shaped endpoint by the same client. Inside compose
# the API reaches it as http://ollama:11434/v1, and compose.yml sets that. Ollama
# ignores the key, but the client will not call without one, so any word will do.
# Leave FALLBACK_API_KEY empty to run with no fallback. FALLBACK_TIMEOUT is how long
# the fallback may take to answer, in seconds: on a CPU, a minute or more.
#
# Lesson 4's Gemini, for comparison: FALLBACK_BASE=https://generativelanguage.googleapis.com/v1beta/openai,
# FALLBACK_MODEL=gemini-2.5-flash-lite, and a key from aistudio.google.com.
FALLBACK_BASE=http://localhost:${OLLAMA_PORT}/v1
FALLBACK_MODEL=${OLLAMA_MODEL}
FALLBACK_API_KEY=ollama
FALLBACK_TIMEOUT=300
PRIMARY_TIMEOUT=20
PRIMARY_RETRIES=1

# --- traces (Lesson 8) ---
# Langfuse runs in compose. Its first start creates a project holding these two keys,
# and a user to log in as at http://localhost:${LANGFUSE_PORT}. The API sends its traces
# with the same two keys. Leave LANGFUSE_PUBLIC_KEY empty to run with no tracing at all.
# Inside compose the API reaches Langfuse as http://langfuse-web:3000, and compose.yml
# sets that. Langfuse's own secrets (LANGFUSE_SALT, LANGFUSE_ENCRYPTION_KEY,
# LANGFUSE_NEXTAUTH_SECRET and three passwords) have course defaults in compose.yml.
# They and everything below are fine on your laptop and wrong anywhere else.
LANGFUSE_PUBLIC_KEY=pk-lf-docchat
LANGFUSE_SECRET_KEY=sk-lf-docchat
LANGFUSE_PORT=3000
LANGFUSE_BASE_URL=http://localhost:${LANGFUSE_PORT}
LANGFUSE_USER_EMAIL=dev@docchat.local
LANGFUSE_USER_PASSWORD=docchat-dev

# --- paths and logging ---
CORPUS_DIR=data/pdfs
UPLOAD_DIR=data/uploads
QDRANT_COLLECTION=chunks
LOG_LEVEL=INFO
