# Copy to .env and fill in. .env is in .gitignore and never gets committed.
# Everything the application needs to know about the world it is running in
# is in this file. Nothing here appears in the code.

# --- the model provider (GenAI Lesson 7) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE=https://api.openai.com/v1
GEN_MODEL=gpt-4o-mini

# --- the databases ---
# Postgres's credentials, written once. compose.yml gives them to the postgres
# container and builds the API's in-network DATABASE_URL from them (Lesson 6).
POSTGRES_USER=docchat
POSTGRES_PASSWORD=docchat
POSTGRES_DB=docchat

# Host ports for compose.yml. If a default is taken on your machine, change it
# here and the URLs below follow.
POSTGRES_PORT=5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Where the app finds the databases when it runs on the host: localhost and the
# host ports. Inside compose they are service names, postgres:5432 and qdrant:6333,
# and compose.yml sets that. It is the whole of what Lesson 6 changes.
QDRANT_URL=http://localhost:${QDRANT_PORT}
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- local models, run in-process on CPU ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- retrieval, the Lesson 15 and 16 settings ---
SHORTLIST=20
TOP_K=5
GATE=0.15
CHUNK_TOKENS=400
CHUNK_OVERLAP=60

# --- the API (Lesson 3) and the UI (Lesson 5) ---
# The server binds API_HOST:API_PORT. Clients, the notebooks and Lesson 5's UI,
# call API_URL. Inside compose the API binds 0.0.0.0:8000, API_PORT becomes its
# host port, and the UI calls http://api:8000. UI_PORT is the page's host port.
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://localhost:${API_PORT}
UI_PORT=8501
MAX_UPLOAD_MB=50

# --- the conversation and its limits (Lesson 4) ---
# HISTORY_TOKENS caps the past turns sent back to the model; older turns are
# folded into a summary of at most SUMMARY_TOKENS. USER_DAILY_TOKENS is what
# one X-User-Id may spend in a rolling 24 hours.
HISTORY_TOKENS=1200
SUMMARY_TOKENS=200
USER_DAILY_TOKENS=50000
CACHE_ANSWERS=true
GUARD_CONTEXT=true

# --- the fallback provider (Lesson 4) ---
# Tried when the primary fails or times out. Gemini, through its OpenAI-shaped
# endpoint, is the GenAI Lesson 7 second provider. Key from aistudio.google.com.
# Leave FALLBACK_API_KEY empty to run with no fallback. Lesson 7 swaps in Ollama.
FALLBACK_BASE=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_MODEL=gemini-2.5-flash-lite
FALLBACK_API_KEY=
PRIMARY_TIMEOUT=20
PRIMARY_RETRIES=1

# --- paths and logging ---
CORPUS_DIR=data/pdfs
UPLOAD_DIR=data/uploads
QDRANT_COLLECTION=chunks
LOG_LEVEL=INFO
